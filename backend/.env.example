# ── COSMEON FS-LITE Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for LOCAL development.
# Only override what you need.

# ── Database ──────────────────────────────────────────────────────────────
# LOCAL DEV:  Leave unset → defaults to sqlite:///fs_lite.db
# AWS PROD:   Set to your RDS MySQL endpoint:
# DATABASE_URL=mysql+pymysql://admin:YourPassword@your-rds.amazonaws.com:3306/cosmeon_dfs

# ── JWT Secret (REQUIRED for production) ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=your-super-secret-key-here

# ── Admin Credentials (REQUIRED for production) ──────────────────────────
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@cosmeon.space
# ADMIN_PASSWORD=YourStrongPassword123!

# ── Storage Backend ──────────────────────────────────────────────────────
# "local" (default — files on disk) or "s3" (AWS S3 bucket)
# STORAGE_BACKEND=local

# ── AWS S3 (only needed if STORAGE_BACKEND=s3) ──────────────────────────
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=ap-south-1
# AWS credentials: use IAM role on EC2/ECS (preferred) or set env vars:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── CORS Origins ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ── Security ─────────────────────────────────────────────────────────────
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# MAX_FILE_SIZE_MB=500

# ── Debug Mode ───────────────────────────────────────────────────────────
# Set to False in production (enables secret validation warnings)
# DEBUG=False
